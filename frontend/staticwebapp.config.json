{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/*.{css,scss,js,png,gif,jpg,jpeg,svg,ico,json,woff,woff2,ttf,eot}"]
  },
  "routes": [
    { "route": "/api/*", "allowedRoles": ["anonymous"] }
  ],
  "responseOverrides": {
    "404": { "rewrite": "/index.html", "statusCode": 200 }
  }
}
